CORDON_DATABASE_URL=sqlite:///./backend/data/cordon.db
CORDON_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORDON_DEFAULT_BUDGET_LIMIT_USD=3.0
CORDON_DEFAULT_MAX_STEPS=200
CORDON_DEFAULT_RUNTIME_LIMIT_SECONDS=900
CORDON_ENABLE_REDACTION=true
CORDON_AUTH_MODE=open

# Frontend
NEXT_PUBLIC_CORDON_API_URL=http://localhost:8000

# SDK / CLI
CORDON_BACKEND_URL=http://localhost:8000
CORDON_AGENT_NAME=Cordon Demo Agent
CORDON_PROVIDER=openai
CORDON_MODEL=gpt-4.1-mini

# Supabase (for production deployment)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-key
# SUPABASE_JWT_SECRET=your-jwt-secret
# CORDON_AUTH_MODE=supabase
# CORDON_DATABASE_URL=postgresql://user:pass@host:5432/dbname
